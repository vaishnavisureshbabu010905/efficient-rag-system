# M5: LLM Configuration (Production)
# Choose provider: 'openai', 'anthropic', or 'mock'
# Production: Use 'openai' or 'anthropic' with API key
# Testing: Use 'mock' for offline unit tests (no API key needed)
LLM_PROVIDER=openai

# OpenAI Configuration
# Model options: gpt-4, gpt-4-turbo, gpt-3.5-turbo
# Get key from https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic Configuration
# Model options: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
# Get key from https://console.anthropic.com/
ANTHROPIC_API_KEY=

# LLM Model name (depends on provider)
# - openai: "gpt-4", "gpt-4-turbo", "gpt-3.5-turbo"
# - anthropic: "claude-3-opus-20240229", "claude-3-sonnet-20240229", etc.
# - mock: any string (for testing only)
LLM_MODEL=gpt-4

# LLM Generation Parameters
# Temperature (0.0-2.0): Lower = more focused, higher = more creative
LLM_TEMPERATURE=0.2

# Max output tokens (response length)
LLM_MAX_TOKENS=512

# API timeout (seconds)
LLM_TIMEOUT=30

# M6: API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=*

# Document path
DOCUMENTS_PATH=data/sample_documents

# M5: RAG Configuration
MAX_CONTEXT_TOKENS=2000

# Retrieval top-K parameter
TOP_K=5
