# M5: LLM Configuration
# Set to 'mock' for demo (no API key needed)
# Set to 'openai' for GPT models (requires OPENAI_API_KEY)
# Set to 'anthropic' for Claude models (requires ANTHROPIC_API_KEY)
LLM_PROVIDER=mock

# LLM model name (depends on provider)
# - mock: any string (e.g., "mock-model")
# - openai: "gpt-3.5-turbo", "gpt-4", etc.
# - anthropic: "claude-3-sonnet-20240229", etc.
LLM_MODEL=mock-model

# API key for LLM providers (only needed if LLM_PROVIDER is openai or anthropic)
# OpenAI: https://platform.openai.com/api-keys
# Anthropic: https://console.anthropic.com/
# LLM_API_KEY=your_api_key_here

# M6: API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# CORS origins (comma-separated)
CORS_ORIGINS=*

# Document path
DOCUMENTS_PATH=data/sample_documents

# M5: RAG Configuration
MAX_CONTEXT_TOKENS=2000

# Top-K default for retrieval
TOP_K=5
